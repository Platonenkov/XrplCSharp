<Project Sdk="Microsoft.NET.Sdk">

        <PropertyGroup>
                <!-- <TargetFramework>netstandard2.0</TargetFramework> -->
                <TargetFramework>net10.0</TargetFramework>
                <RootNamespace>XrplTests</RootNamespace>
                <RollForward>Major</RollForward>
        </PropertyGroup>
        <PropertyGroup>
                <InvariantGlobalization>true</InvariantGlobalization>
        </PropertyGroup>
        <ItemGroup>
                <None Remove="Microsoft.NET.Test.Sdk" />
                <None Remove="MSTest.TestFramework" />
                <None Remove="MSTest.TestAdapter" />
                <None Remove="Flurl.Http" />
        </ItemGroup>
        <ItemGroup>
                <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
                <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
                <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
                <PackageReference Include="Flurl.Http" Version="4.0.2" />
        </ItemGroup>
        <ItemGroup>
                <Compile Condition=" '$(EnableDefaultCompileItems)' == 'true' " Update="Keypairs.Tests\Properties\Resources.Designer.cs">
                        <DependentUpon>Resources.resx</DependentUpon>
                </Compile>
        </ItemGroup>
        <ItemGroup>
                <None Include="..\..\Base\Xrpl.BinaryCodec\Enums\definitions.json" Link="definitions.json">
                        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </None>
                <!-- Update, not Include: the SDK's default None glob already picks these up,
                     so Include would declare them twice. Only the fixtures themselves are
                     copied — the .ref sidecars document the pin and are never read by tests. -->
                <None Update="Fixtures\transactions.macro">
                        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </None>
                <None Update="Fixtures\HashPrefix.h">
                        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </None>
                <None Update="Fixtures\LedgerFormats.h">
                        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </None>
                <None Update="Fixtures\ledger_entries.macro">
                        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </None>
                <!-- Live mainnet response corpus used by TestUResponseFidelity; see Fixtures\Responses\README.md. -->
                <None Update="Fixtures\Responses\*.json">
                        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </None>
        </ItemGroup>
        <ItemGroup>
                <ProjectReference Include="..\..\Xrpl\Xrpl.csproj" />
        </ItemGroup>
</Project>
